# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# Claude Code agent worktrees
.claude/worktrees/

# Gradle output of local Expo modules
apps/mobile/modules/*/android/build/

# Google Play service account key (eas submit); never commit
google-play-service-account*.json

# Firebase client config for push (FCM); never commit (docs/push-setup.md)
google-services*.json
GoogleService-Info.plist
