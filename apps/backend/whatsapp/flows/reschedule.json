{
  "version": "7.1",
  "data_api_version": "3.0",
  "routing_model": {
    "DATE": ["SLOT"],
    "SLOT": ["SUMMARY"],
    "SUMMARY": []
  },
  "screens": [
    {
      "id": "DATE",
      "title": "Pick a new date",
      "data": {
        "service_id": { "type": "string", "__example__": "00000000-0000-4000-8000-000000000001" },
        "staff_id": { "type": "string", "__example__": "00000000-0000-4000-8000-000000000002" },
        "min_date": { "type": "string", "__example__": "2026-09-29" },
        "max_date": { "type": "string", "__example__": "2026-11-27" },
        "unavailable_dates": {
          "type": "array",
          "items": { "type": "string" },
          "__example__": ["2026-10-04"]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextSubheading", "text": "Which day suits you?" },
          {
            "type": "DatePicker",
            "name": "date",
            "label": "Date",
            "required": true,
            "min-date": "${data.min_date}",
            "max-date": "${data.max_date}",
            "unavailable-dates": "${data.unavailable_dates}"
          },
          {
            "type": "Footer",
            "label": "Continue",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "service_id": "${data.service_id}",
                "staff_id": "${data.staff_id}",
                "date": "${form.date}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SLOT",
      "title": "Pick a new time",
      "data": {
        "service_id": { "type": "string", "__example__": "00000000-0000-4000-8000-000000000001" },
        "staff_id": { "type": "string", "__example__": "00000000-0000-4000-8000-000000000002" },
        "date": { "type": "string", "__example__": "2026-09-29" },
        "date_label": { "type": "string", "__example__": "Tue 29 Sep" },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "id": { "type": "string" }, "title": { "type": "string" } }
          },
          "__example__": [{ "id": "slot:2026-09-29T07:00:00.000Z|00000000-0000-4000-8000-000000000002", "title": "09:00" }]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextSubheading", "text": "${data.date_label}" },
          {
            "type": "Dropdown",
            "name": "slot",
            "label": "Time",
            "required": true,
            "data-source": "${data.slots}"
          },
          {
            "type": "Footer",
            "label": "Continue",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "service_id": "${data.service_id}",
                "staff_id": "${data.staff_id}",
                "date": "${data.date}",
                "slot": "${form.slot}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SUMMARY",
      "title": "Confirm new time",
      "terminal": true,
      "success": true,
      "data": {
        "service_id": { "type": "string", "__example__": "00000000-0000-4000-8000-000000000001" },
        "staff_id": { "type": "string", "__example__": "00000000-0000-4000-8000-000000000002" },
        "date": { "type": "string", "__example__": "2026-09-29" },
        "slot": { "type": "string", "__example__": "slot:2026-09-29T07:00:00.000Z|00000000-0000-4000-8000-000000000002" },
        "summary": { "type": "string", "__example__": "Service: Haircut\nDate: Tue 29 Sep 2026\nTime: 09:00" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextSubheading", "text": "Please check your new time" },
          { "type": "TextBody", "text": "${data.summary}" },
          {
            "type": "Footer",
            "label": "Confirm",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "service_id": "${data.service_id}",
                "staff_id": "${data.staff_id}",
                "date": "${data.date}",
                "slot": "${data.slot}"
              }
            }
          }
        ]
      }
    }
  ]
}
