# Copy to .env.local (git-ignored) and fill in your own Supabase/Clerk
# dev project values (all empty here; never commit real keys). See docs/clerk-setup.md and docs/BUILD_PLAN.md §6-7.
# Expo inlines EXPO_PUBLIC_* variables at bundle time (src/lib/env.ts reads them).

# Build variant, set per EAS profile in eas.json (development | preview | production). Unset = development.
# production builds the permanent Play id app.getclovie, name Clovie, scheme clovie. The values below for a
# production build come from EAS environment variables (eas env:create --environment production), never from
# a committed file: EXPO_PUBLIC_API_URL, EXPO_PUBLIC_SUPABASE_URL, EXPO_PUBLIC_SUPABASE_ANON_KEY,
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY (pk_live_...), EXPO_PUBLIC_ENV=prod.
APP_VARIANT=

# Hono API base URL. Local `npm run serve` (Supabase CLI) is http://127.0.0.1:54321/functions/v1/api;
# from an Android emulator use http://10.0.2.2:54321/functions/v1/api.
EXPO_PUBLIC_API_URL=

# Supabase project used for reads + Realtime (RLS-scoped). Never the service-role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Clerk publishable key (Dashboard > API Keys). Safe to expose client-side.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Which environment this build talks to: local | dev | prod. Informational (not read by code yet).
# Doppler (npm run dev:mobile) or EAS environment variables supply the real values; this file is the fallback.
EXPO_PUBLIC_ENV=local

# Push notifications (docs/push-setup.md). Read by app.config.ts at build time, not inlined into the bundle.
# Path to this build's Firebase google-services.json (EAS: a file environment variable). Never commit the file.
# Optional locally: a git-ignored ./google-services.json is picked up automatically.
GOOGLE_SERVICES_JSON=
# Expo project id from `eas init`; needed to mint an Expo push token.
EAS_PROJECT_ID=

# PostHog product analytics for the onboarding funnel (src/features/analytics). Optional: leave the key empty and
# analytics is a no-op (nothing is created or sent). Project API key from PostHog > Project settings. Host defaults to EU.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
