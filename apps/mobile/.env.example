# Copy to .env.local (git-ignored) and fill in real values for your Supabase/Clerk
# dev project. See docs/clerk-setup.md and docs/BUILD_PLAN.md §6-7.
# Expo inlines EXPO_PUBLIC_* variables at bundle time (src/lib/env.ts reads them).

# Hono API (backend/), e.g. a Vercel preview URL or http://localhost:3000 for `vercel dev`.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Supabase project used for reads + Realtime (RLS-scoped). Never the service-role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clerk publishable key (Dashboard > API Keys). Safe to expose client-side.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Which environment this build talks to: local | dev | prod. Informational (not read by code yet).
# Doppler (npm run dev:mobile) or EAS environment variables supply the real values; this file is the fallback.
EXPO_PUBLIC_ENV=local

# Origin the companion chat page claims to be served from (scheme://host[:port]). Nerova only frames
# a session for an origin on its allowlist, so this MUST equal the backend's NEROVA_EMBED_ORIGIN.
# Optional: defaults to the origin of EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_COMPANION_ORIGIN=

# Companion implementation: 1 uses Nerova native SDK sheet (@nerova/react-native); anything else (default)
# keeps the iframe sheet. Optional; read by src/lib/env.ts.
EXPO_PUBLIC_COMPANION_SDK=
