{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@shared/*": [
        "../../packages/shared/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "../../packages/shared/**/*",
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "eslint.config.js",
    "jest.setup.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "jest.config.js"
  ]
}
