<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application>
    <!-- One-tap "Talk to Clovie": every entry point (tile, widget, shortcut, launcher icon, side key,
         the "ready" notification) lands here. It starts the voice service while an activity is on
         screen (the only time Android lets a microphone service start) and finishes at once. -->
    <activity
      android:name="expo.modules.clovievoice.VoiceTalkActivity"
      android:exported="true"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:taskAffinity=""
      android:launchMode="singleTask"
      android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    <!-- A second launcher icon, off by default (Settings turns it on). Samsung's side key can open it. -->
    <activity-alias
      android:name="expo.modules.clovievoice.ClovieVoiceLauncher"
      android:targetActivity="expo.modules.clovievoice.VoiceTalkActivity"
      android:enabled="false"
      android:exported="true"
      android:label="@string/clovie_voice_label"
      android:icon="@drawable/ic_clovie_color">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>

    <service
      android:name="expo.modules.clovievoice.VoiceTileService"
      android:exported="true"
      android:icon="@drawable/ic_clovie_tile"
      android:label="@string/clovie_talk_label"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>

    <receiver
      android:name="expo.modules.clovievoice.VoiceWidgetProvider"
      android:exported="false"
      android:label="@string/clovie_talk_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/clovie_voice_widget_info" />
    </receiver>

    <!-- Re-arms hands-free mode: the opening-hours alarm, boot, and app updates. -->
    <receiver android:name="expo.modules.clovievoice.HandsFreeReceiver" android:exported="false">
      <intent-filter>
        <action android:name="expo.modules.clovievoice.REARM" />
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
