{
  "expo": {
    "name": "Clovie",
    "slug": "booking-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "bookingadmin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "si.nerova.booking.dev"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "monochromeImage": "./src/assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#d4e9f4"
      },
      "package": "si.nerova.booking.dev"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-wordmark.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./src/assets/images/splash-wordmark-dark.png",
            "backgroundColor": "#0B0C10"
          }
        }
      ],
      [
        "@clerk/expo",
        {
          "appleSignIn": false
        }
      ],
      "./plugins/with-dev-menu-no-fab.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
