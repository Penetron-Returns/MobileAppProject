# Local: copy to apps/api/.env and run `npm run serve`.
# Hosted: set each value with `supabase secrets set --env-file apps/api/.env` (never commit .env),
# or from Doppler with `npm run env:push-secrets` (docs/environments.md).
# Supabase. Injected automatically inside Supabase Edge Functions; set them only for local runs/tests.
# Never ship the service role key to the app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk
CLERK_SECRET_KEY=
# PEM public key from Clerk dashboard → API keys → "Show JWT public key" (networkless verification)
CLERK_JWT_KEY=
# Comma-separated origins allowed in the `azp` claim (leave empty for native-only)
CLERK_AUTHORIZED_PARTIES=
CLERK_WEBHOOK_SECRET=

# Meta / WhatsApp Cloud API
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=
# RSA private key (PEM) whose public half is uploaded to each phone number for Flows encryption
WHATSAPP_FLOW_PRIVATE_KEY=
WHATSAPP_FLOW_PRIVATE_KEY_PASSPHRASE=
# 6-digit two-step verification PIN used when registering numbers
WHATSAPP_REGISTRATION_PIN=

# 32 random bytes, base64. Encrypts Meta access tokens at rest (AES-256-GCM)
TOKEN_ENCRYPTION_KEY=
# Random secret used to sign WhatsApp Flow tokens
FLOW_TOKEN_SECRET=
# Shared secret pg_cron must send (x-cron-secret header)
CRON_SECRET=
# Public base URL of this API (used for the WhatsApp Flows endpoint_uri), e.g.
# https://<project-ref>.supabase.co/functions/v1/api
API_BASE_URL=
# Base URL of the public web booking page (comparator channel), e.g. https://book.example.com/book
PUBLIC_WEB_BOOKING_URL=
# Stripe (test mode in dev). Server-side only; no code uses these yet (subscriptions are planned).
# Secret key (sk_test_...) from Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...) of the endpoint pointing at <API_BASE_URL>/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Optional: Expo push access token
EXPO_ACCESS_TOKEN=

# Nerova Booking connector (AI companion). Comma-separated SHA-256 hex hashes of the bearer token(s)
# Nerova presents at /connector/nerova/mcp; empty disables the connector. Make a token and its hash with:
#   node -e "const c=require('crypto');const t=c.randomBytes(32).toString('base64url');console.log(t, c.createHash('sha256').update(t).digest('hex'))"
# Give Nerova the token (connection secret) and put only the hash here. Two hashes allow rotation.
NEROVA_CONNECTOR_TOKEN_HASHES=
# Connector read-cache TTL in ms for catalogue, staff and hours (default 30000, 0 disables)
NEROVA_CONNECTOR_CACHE_TTL_MS=
# Signed account events to Nerova. Off unless NEROVA_EVENTS_ENABLED=true; use Nerova TEST first.
NEROVA_EVENTS_ENABLED=
# events.url shown on the Nerova connection (https)
NEROVA_EVENTS_URL=
# events.signingSecret (whsec_...) shown on the Nerova connection
NEROVA_EVENTS_SIGNING_SECRET=
# Signed appointment.created|rescheduled|cancelled|completed|no_show events (same URL and secret). Off unless "true"
NEROVA_APPOINTMENT_EVENTS_ENABLED=
# Connector capability confirm_appointments (client confirmed on a reminder). Off unless "true"; tool contract pending from Nerova
NEROVA_CONFIRM_APPOINTMENTS_ENABLED=

# Nerova PR #946 features, off unless 'true'. Enable only once Nerova confirms it is live and the app is registered
# (node apps/api/scripts/register-nerova-native-app.mjs). Native widget sessions for platform:'native' requests:
NEROVA_NATIVE_SESSIONS=false
# nativeApps appId for native sessions (empty = si.nerova.booking.dev)
NEROVA_APP_ID=
# Forward the allowlisted WhatsApp return_url (bookingadmin://companion/whatsapp-return) to Nerova as returnUrl
NEROVA_WHATSAPP_RETURN_URL=false
# Nerova webhook signing secret (whsec_...), returned once by scripts/nerova/register-approval-webhook.mjs. Verifies POST /webhooks/nerova (approval push). Empty = route answers 503
NEROVA_WEBHOOK_SECRET=

# Cloud speech-to-text for the Clovie voice feature (POST /v1/voice/transcriptions, proxied to Nerova). Off unless 'true'.
# Enable only once Nerova confirms transcription is live in production.
VOICE_CLOUD_STT=false
